# Lakebase connection details. None of these are secrets - the password is an
# OAuth token the app mints at runtime, so nothing here expires.
PGHOST=<your-instance>.database.<region>.cloud.databricks.com
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=you@example.com
PGSSLMODE=require

# Lakebase Autoscaling endpoint path, from the project URL plus the PGHOST prefix:
# projects/{project_id}/branches/{branch_id}/endpoints/{endpoint_id}
LAKEBASE_ENDPOINT=

# Databricks Genie space that governs which trusted Gold-layer (Unity Catalog)
# tables the analytics agent can query.
GENIE_SPACE_ID=

# Optional: pin the agent's reasoning LLM to a specific serving endpoint. Leave
# unset to auto-discover a chat-capable Foundation Model endpoint in the workspace.
# Run `python scripts/list_llm_endpoints.py` to see the names available to you.
DATABRICKS_LLM_ENDPOINT=

